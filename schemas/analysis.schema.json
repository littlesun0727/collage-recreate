{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collage:v5:analysis",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "collage-analysis-v1"
    },
    "reference_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30000
      },
      "minItems": 2,
      "maxItems": 2
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "background",
              "photo",
              "text",
              "overlay"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rotation": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "enum": [
              "cover",
              "feather",
              "cutout"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "text_status": {
            "enum": [
              "known",
              "unreadable"
            ]
          },
          "method": {
            "enum": [
              "local",
              "extract",
              "placeholder"
            ]
          },
          "style": {
            "$ref": "#/$defs/style"
          },
          "appearance": {
            "enum": [
              "rounded_photo",
              "polaroid"
            ]
          },
          "photo_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "embedded_in": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "window_bbox": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "id",
          "kind",
          "bbox",
          "label",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 160
    },
    "layer_order": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    }
  },
  "required": [
    "schema_version",
    "reference_size",
    "objects",
    "layer_order"
  ],
  "additionalProperties": false,
  "$defs": {
    "style": {
      "type": "object",
      "properties": {
        "fill": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "stroke_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "font": {
          "enum": [
            "sans",
            "serif",
            "mono",
            "hand",
            "cjk",
            "cjk-hand"
          ]
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "line_spacing": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "outline_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "outline_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "shape": {
          "enum": [
            "rectangle",
            "rounded_rectangle",
            "ellipse",
            "heart",
            "star",
            "line",
            "arrow",
            "polygon",
            "polyline",
            "paper",
            "tape",
            "frame",
            "paperclip",
            "rays",
            "curve"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30
        },
        "inner_ratio": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95
        },
        "texture": {
          "enum": [
            "none",
            "paper",
            "grain",
            "dots",
            "stripes",
            "grid"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "extract_background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "extract_tolerance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "dash": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "line_cap": {
          "enum": [
            "butt",
            "round"
          ]
        },
        "extract_mode": {
          "enum": [
            "auto",
            "foreground",
            "color",
            "crop"
          ]
        },
        "corner_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "edge": {
          "enum": [
            "straight",
            "torn"
          ]
        },
        "card": {
          "type": "object",
          "properties": {
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "padding": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 30000
              },
              "minItems": 4,
              "maxItems": 4
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            }
          },
          "additionalProperties": false
        },
        "shadow": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "blur": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "offset": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
