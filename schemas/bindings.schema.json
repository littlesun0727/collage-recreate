{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collage:v5:bindings",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "collage-bindings-v1"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "crop_center": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "source_crop": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "mirror_x": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "slot_id",
          "asset_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "user",
              "generated"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "text",
          "origin",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "photos",
    "texts"
  ],
  "additionalProperties": false
}
