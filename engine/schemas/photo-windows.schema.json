{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collage:v6:photo-windows",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "collage-photo-windows-v1"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "shape": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "rectangle",
                  "rounded_rect",
                  "ellipse",
                  "circle",
                  "star",
                  "heart",
                  "polygon"
                ]
              },
              "corner_radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "star_points": {
                "type": "integer",
                "minimum": 3,
                "maximum": 12
              },
              "inner_ratio": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 0.9
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "maxItems": 32,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "rounded_rect"
                    }
                  }
                },
                "then": {
                  "required": [
                    "corner_radius"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "star"
                    }
                  }
                },
                "then": {
                  "required": [
                    "star_points",
                    "inner_ratio"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "polygon"
                    }
                  }
                },
                "then": {
                  "required": [
                    "points"
                  ]
                }
              }
            ]
          },
          "subject": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "preserve",
                  "cutout"
                ]
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          },
          "stroke": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "target": {
                "enum": [
                  "window",
                  "subject"
                ]
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "pattern": {
                "enum": [
                  "solid",
                  "dash",
                  "dot"
                ]
              },
              "dash": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 0.5
                },
                "minItems": 2,
                "maxItems": 2
              },
              "line_cap": {
                "enum": [
                  "butt",
                  "round"
                ]
              },
              "placement": {
                "enum": [
                  "inside",
                  "center",
                  "outside"
                ]
              },
              "offset": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.2
              }
            },
            "required": [
              "enabled",
              "target",
              "width",
              "color"
            ],
            "additionalProperties": false
          },
          "edge_softness": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.05
          },
          "fade": {
            "type": "object",
            "properties": {
              "top": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "bottom": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "left": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "right": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              }
            },
            "required": [
              "top",
              "bottom",
              "left",
              "right"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "linked_to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "description": "Only a continuous pop-out foreground: share the named base photo source, crop, transform and video time."
          },
          "seams": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "edge": {
                  "enum": [
                    "top",
                    "bottom",
                    "left",
                    "right"
                  ]
                },
                "underlay_id": {
                  "type": "string"
                },
                "width": {
                  "type": "number",
                "minimum": 0,
                  "maximum": 0.5
                }
              },
              "required": [
                "edge",
                "underlay_id",
                "width"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "photo_id",
          "shape",
          "subject",
          "stroke",
          "edge_softness",
          "fade",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "photos"
  ],
  "additionalProperties": false
}
